# Copy to .env in the backend directory; Spring Boot imports it automatically.
# Java properties syntax: KEY=value, no export, no surrounding quotes.
# Escape a literal backslash as \\; keep comments on separate lines.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/collabnote
DB_USERNAME=collabnote
DB_PASSWORD=replace-with-local-password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PORT=8080

# Auth: Base64 of at least 32 random bytes; generate with: openssl rand -base64 32
AUTH_JWT_SECRET=replace-with-base64-random-secret
AUTH_ACCESS_TTL=15m
AUTH_SESSION_TTL=7d
# Secure cookies default true; dev profile defaults false for local HTTP.
# AUTH_COOKIE_SECURE=true
AUTH_MAIL_ENABLED=false
AUTH_MAIL_FROM=noreply@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
AUTH_VERIFICATION_URL=http://localhost:3000/verify-email
AUTH_RESET_URL=http://localhost:3000/reset-password
